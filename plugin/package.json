{
  "name": "mm-plugin-copas",
  "version": "0.1.0",
  "description": "Copas for MetaMask Agent Wallet: copy bonded Perpl traders on Monad with on-chain risk limits, slashing claims and outflow caps",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "oclif-plugin",
    "mm-plugin",
    "agent-wallet",
    "copytrade",
    "perps",
    "monad",
    "perpl"
  ],
  "files": [
    "dist",
    "oclif.manifest.json",
    "abis",
    "deployments",
    "skills"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sync": "node scripts/sync-contracts.mjs",
    "build": "node scripts/sync-contracts.mjs && tsc -p tsconfig.json && oclif manifest",
    "prepack": "npm run build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "copas": {
        "description": "Copy bonded Perpl traders on Monad with on-chain risk limits (Copas)"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^7.0.0",
    "capabilities": [],
    "commands": [
      {
        "id": "copas:leaders",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "network"
        ],
        "targetChains": [
          143,
          10143
        ]
      },
      {
