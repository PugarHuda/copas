# @copas/services — every key is optional; a route whose key is missing answers 503 with { missing }.
PORT=8787

# Leader data. Unset = plumb public indexer (https://plumb.huginn.tech). Set = copas/indexer (Envio HyperIndex).
ENVIO_GRAPHQL_URL=

# Kimi K3 analyst (D1/D3). Base defaults to https://api.moonshot.ai/v1
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_LOG_PATH=data/kimi-log.jsonl

# Nansen (D2/D4): API key (credits) and/or x402 wallet paying USDC on Monad (eip155:143).
NANSEN_API_KEY=
X402_PRIVATE_KEY=
# apikey | x402 (default: apikey if NANSEN_API_KEY is set, else x402)
NANSEN_PAYMENT_MODE=

# Tenderly simulation (C4). Unset = eth_simulateV1 on the Monad RPC.
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Copas/Perpl ABIs used to decode events in the fallback (default: ../abis)
COPAS_ABIS_DIR=

# Track-record attestation (A7): EIP-191 signer. Use a dedicated key, never a funded one.
ATTESTER_PRIVATE_KEY=
