# All optional: the app runs with these defaults.

# Chain Copas contracts live on: 143 = Monad mainnet, anything else = testnet 10143
NEXT_PUBLIC_COPAS_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Server-side reads (Perpl analytics)
MONAD_RPC_URL=https://rpc.monad.xyz
# eth_getLogs endpoint for flow/liquidation/trade scans. rpc2 allows 10k-block ranges (others: 100).
MONAD_LOGS_RPC_URL=https://rpc2.monad.xyz
# Days of deposits/withdrawals/liquidations scanned from logs (~150 getLogs calls per 7 days)
FLOWS_SCAN_DAYS=7
# Hours of Perpl logs scanned for a wallet's trades when no indexer is set
TRADE_SCAN_HOURS=6
PERPL_API_URL=https://app.perpl.xyz/api

# Envio GraphQL indexer; replaces log scans for wallet history when set
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=

# Copas off-chain services (backtest, AI analysis, simulate) proxied via /api/services
COPAS_SERVICES_URL=http://localhost:8787

# Passkey relying-party ID; defaults to window.location.hostname. Must match the domain passkeys were created on.
NEXT_PUBLIC_MERA_RP_ID=
