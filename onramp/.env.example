PORT=8787
CORS_ORIGIN=http://localhost:3000

# Aurora Intents Swap/Deposits key (studio.aurora.dev). Optional: without it the public 1Click host is used (+25 bps).
# Not confidential per Aurora docs, but kept server-side anyway. Persistent deposit addresses need an Aurora-approved org.
AURORA_API_KEY=

# Aurora Intents Connect (alpha). Recipe + key proxy are only enabled with AURORA_CONNECT=1.
AURORA_CONNECT=0
AURORA_CONNECT_API_KEY=

# Kuru Flow referrer (fee in bps, taken from the swap output)
KURU_REFERRER=
KURU_REFERRER_FEE_BPS=0

# scripts/kuru-down-market.ts (Monad TESTNET only)
PRIVATE_KEY=
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
