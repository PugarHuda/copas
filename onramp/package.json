{
  "name": "@copas/onramp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/aurora/connect.d.ts",
      "import": "./dist/aurora/connect.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "kuru:down-market": "tsx scripts/kuru-down-market.ts"
  },
  "dependencies": {
    "@aurora-is-near/intents-connect": "^7.24.2",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
