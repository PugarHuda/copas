# Required: HyperSync/HyperRPC token (free personal token) https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# Copas addresses (until contracts/deployments/<chainId>.json exists). Unset = zero address = not indexed.
# LeaderBook / FollowerVault / UnderwriterPool are discovered from CopasRegistry automatically.
# ENVIO_COPAS_REGISTRY_143=0x...
# ENVIO_COPAS_BREACH_MARKET_143=0x...
# ENVIO_COPAS_AGENT_REGISTRY_143=0x...
# ENVIO_COPAS_REGISTRY_10143=0x...
# ENVIO_COPAS_BREACH_MARKET_10143=0x...
# ENVIO_COPAS_AGENT_REGISTRY_10143=0x...
