{
  "name": "copas-keeper",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "tick": "tsx src/index.ts --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "privy:setup": "tsx scripts/privy-setup.ts",
    "privy:deny-demo": "tsx scripts/privy-deny-demo.ts",
    "dynamic:agent": "tsx scripts/dynamic-agent.ts"
  },
  "dependencies": {
    "@dynamic-labs-wallet/node": "1.1.22",
    "@dynamic-labs-wallet/node-evm": "1.1.22",
    "@privy-io/node": "^0.35.0",
    "@vercel/blob": "^2.8.1",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
