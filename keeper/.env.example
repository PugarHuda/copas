# ---- chain
CHAIN_ID=10143                         # 143 mainnet | 10143 testnet
MONAD_RPC_URL=                         # default https://rpc.monad.xyz | https://testnet-rpc.monad.xyz
MONAD_WS_URL=                          # optional, e.g. wss://rpc.monad.xyz -> new-head driven instead of polling
DEPLOYMENTS_FILE=                      # default ../contracts/deployments/<CHAIN_ID>.json
ABIS_DIR=                              # default ../abis
START_BLOCK=                           # first-run VaultCreated backfill start (default: deployments.block)
POLL_MS=1500
LOG_CHUNK_BLOCKS=100                   # public RPC caps eth_getLogs at 100 blocks
CHECKPOINT_EVERY_BLOCKS=150            # ~1 min at 0.4 s blocks
UNWIND_SCAN_EVERY_BLOCKS=50
DD_ALERT_FRACTION=0.8                  # alert when drawdown >= 80% of the leader's mandate

# ---- signer
SIGNER_MODE=LOCAL                      # LOCAL | PRIVY
KEEPER_PRIVATE_KEY=                    # LOCAL only (dev/testnet). Needs a little MON for gas.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=               # base64 PKCS8 P-256 key owning wallet+policy (printed by pnpm privy:setup)
PRIVY_WALLET_ID=                       # printed by pnpm privy:setup
PRIVY_POLICY_ID=                       # informational
PRIVY_SPONSOR=true                     # Privy native gas sponsorship (sponsor: true)

# ---- optional jobs
ENABLE_BREACH_SETTLE=true              # BreachMarket.settle for finished/breached epochs
ENABLE_8004_FEEDBACK=false             # ERC-8004 ReputationRegistry.giveFeedback after each epoch of agent leaders
FEEDBACK_URI_BASE=                     # e.g. https://copas.xyz -> feedbackURI=<base>/leader/<addr>?epoch=<e>

# ---- alerts
TELEGRAM_BOT_TOKEN=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ---- http / storage
PORT=8787
DATA_DIR=data
DEBUG=                                 # 1 = debug logs (shows skipped no-op txs)
